    "/me": {
      "get": {
        "operationId": "me.get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "balance": {
                      "anyOf": [
                        {
                          "properties": {
                            "subscription": {
                              "description": "Credited on each renewal; spent first; reset on renewal.",
                              "properties": {
                                "amountMinor": {
                                  "maximum": 9007199254740991,
                                  "minimum": -9007199254740991,
                                  "type": "integer"
                                },
                                "currencyCode": {
                                  "maxLength": 3,
                                  "minLength": 3,
                                  "type": "string"
                                }
                              },
                              "required": [
                                "amountMinor",
                                "currencyCode"
                              ],
                              "type": "object"
                            },
                            "topup": {
                              "description": "Top-ups and bonuses; never resets.",
                              "properties": {
                                "amountMinor": {
                                  "maximum": 9007199254740991,
                                  "minimum": -9007199254740991,
                                  "type": "integer"
                                },
                                "currencyCode": {
                                  "maxLength": 3,
                                  "minLength": 3,
                                  "type": "string"
                                }
                              },
                              "required": [
                                "amountMinor",
                                "currencyCode"
                              ],
                              "type": "object"
                            },
                            "total": {
                              "properties": {
                                "amountMinor": {
                                  "maximum": 9007199254740991,
                                  "minimum": -9007199254740991,
                                  "type": "integer"
                                },
                                "currencyCode": {
                                  "maxLength": 3,
                                  "minLength": 3,
                                  "type": "string"
                                }
                              },
                              "required": [
                                "amountMinor",
                                "currencyCode"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "subscription",
                            "topup",
                            "total"
                          ],
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Null until the account has a balance row."
                    },
                    "email": {
                      "type": "string"
                    },
                    "emailVerified": {
                      "type": "boolean"
                    },
                    "features": {
                      "properties": {
                        "topup": {
                          "description": "One-time balance top-up is offered to this user.",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "topup"
                      ],
                      "type": "object"
                    },
                    "hasActiveSubscription": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    },
                    "isTester": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "email",
                    "emailVerified",
                    "isTester",
                    "hasActiveSubscription",
                    "balance",
                    "features"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "description": "Declared for this status: UNAUTHORIZED. Other codes may appear.",
                      "type": "string"
                    },
                    "data": {},
                    "defined": {
                      "description": "True when the procedure declares this error.",
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "defined",
                    "code",
                    "status",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "401"
          }
        },
        "summary": "The signed-in user and their balance",
        "tags": [
          "me"
        ]
      }
