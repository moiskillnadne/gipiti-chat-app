                          "type": "object"
                        },
                        "presets": {
                          "items": {
                            "properties": {
                              "amountMinor": {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer"
                              },
                              "currencyCode": {
                                "maxLength": 3,
                                "minLength": 3,
                                "type": "string"
                              }
                            },
                            "required": [
                              "amountMinor",
                              "currencyCode"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "minimum",
                        "maximum",
                        "presets"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "clients",
                    "features",
                    "bonuses",
                    "topup"
