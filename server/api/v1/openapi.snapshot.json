{
  "info": {
    "title": "GIPITI API",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/config": {
      "get": {
        "operationId": "config.get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "bonuses": {
                      "properties": {
                        "emailConfirm": {
                          "properties": {
                            "amountMinor": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            },
                            "currencyCode": {
                              "maxLength": 3,
                              "minLength": 3,
                              "type": "string"
                            }
                          },
                          "required": [
                            "amountMinor",
                            "currencyCode"
                          ],
                          "type": "object"
                        },
                        "onboardingQuiz": {
                          "properties": {
                            "amountMinor": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            },
                            "currencyCode": {
                              "maxLength": 3,
                              "minLength": 3,
                              "type": "string"
                            }
                          },
                          "required": [
                            "amountMinor",
                            "currencyCode"
                          ],
                          "type": "object"
                        },
                        "welcome": {
                          "properties": {
                            "amountMinor": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            },
                            "currencyCode": {
                              "maxLength": 3,
                              "minLength": 3,
                              "type": "string"
                            }
                          },
                          "required": [
                            "amountMinor",
                            "currencyCode"
                          ],
                          "type": "object"
                        }
                      },
                      "required": [
                        "welcome",
                        "emailConfirm",
                        "onboardingQuiz"
                      ],
                      "type": "object"
                    },
                    "clients": {
                      "properties": {
                        "android": {
                          "properties": {
                            "latestVersion": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "minSupportedVersion": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "updateUrl": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "minSupportedVersion",
                            "latestVersion",
                            "updateUrl"
                          ],
                          "type": "object"
                        },
                        "ios": {
                          "properties": {
                            "latestVersion": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "minSupportedVersion": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "updateUrl": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "minSupportedVersion",
                            "latestVersion",
                            "updateUrl"
                          ],
                          "type": "object"
                        }
                      },
                      "required": [
                        "ios",
                        "android"
                      ],
                      "type": "object"
                    },
                    "features": {
                      "properties": {
                        "signup": {
                          "description": "New accounts can be created.",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "signup"
                      ],
                      "type": "object"
                    },
                    "topup": {
                      "properties": {
                        "maximum": {
                          "properties": {
                            "amountMinor": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            },
                            "currencyCode": {
                              "maxLength": 3,
                              "minLength": 3,
                              "type": "string"
                            }
                          },
                          "required": [
                            "amountMinor",
                            "currencyCode"
                          ],
                          "type": "object"
                        },
                        "minimum": {
                          "properties": {
                            "amountMinor": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            },
                            "currencyCode": {
                              "maxLength": 3,
                              "minLength": 3,
                              "type": "string"
                            }
                          },
                          "required": [
                            "amountMinor",
                            "currencyCode"
