# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Signs the access tokens of the API (/api/v1/auth). At least 32 characters;
# must differ from AUTH_SECRET. Optional outside production, where a built-in
# development value is used. `openssl rand -base64 48`
API_TOKEN_SECRET=****
# Only while rotating API_TOKEN_SECRET: the old value, so that tokens signed
# with it stay valid for their 15 minutes. Remove it afterwards.
# API_TOKEN_SECRET_PREVIOUS=

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# AI Gateway API Key (required for non-Vercel deployments)
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****

# Local database for `pnpm test:integration`. The tests truncate tables, so the
# run refuses any host other than localhost and any database whose name does not
# end in "_test". The database is created and migrated on the first run.
TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/gipiti_test


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****


# Resend API Key for sending emails (password reset, notifications)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=****
RESEND_WEBHOOK_SECRET=****
EMAIL_FORWARD_TO=****

# Upstash Redis REST API for rate limiting (chat, password reset, verification
# resend, payment status). Without it every limiter is OFF and lets all requests
# through; GET /api/health then reports `checks.rateLimiting.enabled: false`.
# Option 1: explicit REST API credentials (recommended)
# Get from Upstash Console > Your Database > REST API section
KV_REST_API_URL=****
KV_REST_API_TOKEN=****

# Option 2: REDIS_URL in Upstash REST format (https://...) plus REDIS_TOKEN.
# A redis:// REDIS_URL (the form resumable streams need) does NOT enable the
# rate limiter, so with that form use Option 1.
# REDIS_TOKEN=****



NEXT_PUBLIC_APP_URL=****

# Vercel Flags (feature flags) — auto-provisioned when a flag is created
# in the Vercel dashboard; pull locally with `vercel env pull`
# https://vercel.com/docs/flags/vercel-flags
FLAGS=****
FLAGS_SECRET=****

# Tavily API Key for web search functionality
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=****

# Prompt library catalog source (Google Sheet) — used by scripts/sync-prompts.ts
# The sheet must be shared as "Anyone with the link can view".
# PROMPTS_SHEET_ID is the id in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<PROMPTS_SHEET_ID>/edit#gid=<PROMPTS_SHEET_GID>
PROMPTS_SHEET_ID=
# Optional: target a specific tab by gid (preferred) or by name. Defaults to the first tab.
PROMPTS_SHEET_GID=
PROMPTS_SHEET_NAME=

# Blog author preview tool (/blog/preview) — shared secret that gates the page in
# production via proxy.ts (open in development). Share the URL `/blog/preview?key=<value>`
# with the article author. Generate any random string, e.g. `openssl rand -hex 16`.
BLOG_PREVIEW_KEY=